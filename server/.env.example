# ==========================================================================
# Servidor próprio do tdm-angular-novo (server/)
# NÃO reaproveita nenhuma variável/segredo do projeto legado portal-tdm-negocios.
# Copie este arquivo para ".env" e preencha os valores reais em ambiente seguro.
# ==========================================================================

# Porta HTTP deste servidor (Gateway + Auth)
PORT=3000

# ------------------------------------------------------------------------
# Autenticação corporativa (JWT emitido por este servidor para o Angular)
# ------------------------------------------------------------------------
# Segredo usado para assinar o JWT de sessão do Portal (nunca é o mesmo
# token/senha do Broadcom TDM).
JWT_SECRET=troque-por-um-segredo-forte-e-unico
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------
# Credenciais do Broadcom TDM
# Usadas EXCLUSIVAMENTE por este servidor para obter o Bearer Token do TDM.
# O Angular nunca tem acesso a estas credenciais.
# ------------------------------------------------------------------------
TDM_BASE_URL=https://10.198.2.185:8443
TDM_USERNAME=
TDM_PASSWORD=

# Opcional: preencher somente para usar manualmente um Bearer Token
# específico. Vazio = o servidor executa Auto-Login e renova a sessão
# automaticamente quando necessário.
TDM_BEARER_TOKEN=

# Cabeçalhos de navegação exigidos por alguns endpoints do TDM
TDM_ORIGIN=
TDM_REFERER=
